# ─────────────────────────────────────────────
# تنظیمات بک‌اند فروشگاه — این فایل را کپی کنید:
#   cp .env.example .env
# سپس مقادیر واقعی را در .env وارد کنید (.env هرگز در git قرار نمی‌گیرد)
# ─────────────────────────────────────────────

# ── دیتابیس MySQL ────────────────────────────
DB_HOST=localhost
DB_PORT=3307
DB_USERNAME=root
DB_PASSWORD=root
DB_DATABASE=store_db

# ── احراز هویت JWT ───────────────────────────
# یک رشته تصادفی بلند برای امضای توکن‌ها (مثلاً: openssl rand -hex 32)
JWT_SECRET_KEY=change-me-to-a-long-random-secret
# مدت اعتبار توکن، مثلاً 7d یا 1h
JWT_EXPIRATION=7d

# ── توکن تازه‌سازی (Refresh Token) ───────────
# باید از JWT_SECRET_KEY متفاوت باشد تا یک access توکنِ دزدیده‌شده نتواند برای refresh استفاده شود
JWT_REFRESH_SECRET_KEY=change-me-to-another-long-random-secret
# مدت اعتبار refresh توکن، معمولاً خیلی طولانی‌تر از access (مثلاً 7d یا 30d)
JWT_REFRESH_EXPIRATION=7d

# ── سرور ─────────────────────────────────────
# اختیاری — پیش‌فرض 3000
PORT=3000
